{
  "name": "cascade",
  "version": "0.1.0",
  "private": true,
  "description": "Cascade: an interactive cosmic-ray air shower simulator over the Nevada high desert. WebGPU with a WebGL2 fallback.",
  "license": "MIT",
  "homepage": "https://highsierralabs.github.io/End_of_week_challenge/cascade/",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
